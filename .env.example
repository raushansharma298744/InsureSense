# InsureSense Environment Configuration
# Copy this file to .env and fill in actual values

# Application
APP_NAME=InsureSense
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insuresense
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/insuresense

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000/api/v1

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=insuresense-training

# Model
MODEL_PATH=ml/artifacts/best_model.pkl
MODEL_VERSION=1.0.0

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=csv

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
